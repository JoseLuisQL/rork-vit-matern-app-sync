# VITMATERNA — Versión web de la app (Expo → estáticos) servida con Nginx.
# Se construye automáticamente desde server/docker-compose.yml (servicio "web").

# ── Etapa 1: exportar la app web ─────────────────────────────────────────────
FROM node:20-bookworm-slim AS build
WORKDIR /app

# Bun instala las dependencias respetando bun.lock; Node ejecuta el export.
RUN npm install -g bun@1
COPY package.json bun.lock ./
RUN bun install
COPY . .

# Por defecto la web usa el MISMO dominio desde el que se sirve (nginx pasa
# /api al contenedor api). Solo define esta variable si la web vivirá en un
# dominio distinto al de la API:
#   --build-arg EXPO_PUBLIC_API_URL=https://api.tudominio.com
ARG EXPO_PUBLIC_API_URL=
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL} \
    EXPO_PUBLIC_RORK_FUNCTIONS_URL= \
    CI=1 \
    EXPO_NO_TELEMETRY=1 \
    NODE_OPTIONS=--max-old-space-size=2048

# Sin .env: las URLs de la vista previa de Rork no deben colarse en este build.
RUN rm -f .env && ./node_modules/.bin/expo export --platform web

# ── Etapa 2: servir los estáticos + proxy hacia la API ───────────────────────
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
