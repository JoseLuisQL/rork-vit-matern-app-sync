# VITMATERNA — Variables del despliegue autoalojado.
# Copia este archivo a .env y completa los valores.

# --- PostgreSQL 17 (contenedor db) ---
POSTGRES_DB=vitmaterna
POSTGRES_USER=vitmaterna
# OBLIGATORIA: usa una contraseña larga y única.
POSTGRES_PASSWORD=

# --- API ---
# Puerto público de la API en el servidor (dentro del contenedor siempre es 8080).
API_PORT=8080

# Primer arranque (base vacía):
#   demo       → cuentas y casos de demostración (DNI 11111111 / 22222222 / 33333333 / 44444444, clave Test@1234)
#   produccion → plataforma limpia con una sola cuenta de administración (datos de abajo)
SEED_MODE=demo

# Solo para SEED_MODE=produccion (cuenta de administración inicial):
ADMIN_DNI=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# --- Solo si usas un PostgreSQL externo gestionado con TLS (no el de este compose) ---
# DATABASE_SSL=true
