{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["server.ts", "functions/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "expo", "server"]
}
