# ============================================================
#  VITMATERNA — Variables de Entorno para PRODUCCIÓN
# ============================================================

# Dominio público para Traefik y la Web/API
APP_DOMAIN=vitmaterna.qware.me
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Base de Datos PostgreSQL 17 ---
POSTGRES_DB=vitmaterna
POSTGRES_USER=vitmaterna_user
# OBLIGATORIO: Establezca una contraseña segura
POSTGRES_PASSWORD=coloca_aqui_un_password_seguro_y_largo

# --- Modo de inicialización ---
# demo       → genera cuentas y datos de prueba (DNI 11111111, 22222222, 33333333, 44444444 con pass: Test@1234)
# produccion → base limpia solo con la cuenta de administrador principal indicada abajo
SEED_MODE=produccion

# --- Administrador inicial (Solo si SEED_MODE=produccion) ---
ADMIN_DNI=10000000
ADMIN_PASSWORD=AdminSeguro2026!
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=Principal
